local ALLOWED_PLACE = 4104106043
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
if not player then return end
if game.PlaceId ~= ALLOWED_PLACE then
	warn("[ElevatorHub] Wrong place id")
	return
end

local pg = player:WaitForChild("PlayerGui")
local env = (typeof(getgenv) == "function" and getgenv()) or _G
env.ElevatorHub = env.ElevatorHub or {}
local Hub = env.ElevatorHub

Hub.player = player
Hub.pg = pg
Hub.killerESP = Hub.killerESP or false
Hub.elevESP = Hub.elevESP or false
Hub.mapESP = Hub.mapESP or false
Hub.cleanVision = Hub.cleanVision or false
Hub.antiRadio = Hub.antiRadio or false
Hub.predVisible = Hub.predVisible ~= false
Hub.godCheckerOn = Hub.godCheckerOn or false
Hub.lastFloorName = Hub.lastFloorName or "Unknown"
Hub.killerHighlights = Hub.killerHighlights or {}
Hub.elevHighlights = Hub.elevHighlights or {}
Hub.mapHighlights = Hub.mapHighlights or {}

function Hub.clearHighlights(tbl)
	if type(tbl) ~= "table" then return end
	for _, h in pairs(tbl) do
		pcall(function()
			if h and h.Destroy then h:Destroy() end
		end)
	end
	table.clear(tbl)
end

function Hub.applyHighlight(obj, color, tbl)
	if not obj or not obj.Parent then return end
	if obj:FindFirstChild("ESPHighlight") then return end
	local h = Instance.new("Highlight")
	h.Name = "ESPHighlight"
	h.Adornee = obj
	h.FillColor = color
	h.OutlineColor = color
	h.FillTransparency = 0.55
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = obj
	table.insert(tbl, h)
end

function Hub.teleport(pos)
	pcall(function()
		local char = player.Character or player.CharacterAdded:Wait()
		local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 3)
		if hrp then hrp.CFrame = CFrame.new(pos) end
	end)
end

function Hub.isKiller(model)
	if not model or not model:IsA("Model") then return false end
	local n = string.lower(model.Name)
	if Players:FindFirstChild(model.Name) then return false end
	if string.find(n, "killer") or string.find(n, "enemy") or string.find(n, "npc") then return true end
	if model:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(model) then
		if string.find(n, "boss") or string.find(n, "monster") or string.find(n, "entity") then return true end
	end
	return false
end

function Hub.applyDefaultSky()
	pcall(function()
		local sky = Instance.new("Sky")
		sky.Name = "DefaultSky"
		sky.Parent = Lighting
	end)
end

function Hub.setCleanVision(on)
	Hub.cleanVision = on
	pcall(function()
		if on then
			Lighting.FogEnd = 1e6
			Lighting.FogStart = 0
			Lighting.Brightness = 2
			for _, v in pairs(Lighting:GetChildren()) do
				if v:IsA("BlurEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") then
					v.Enabled = false
				end
			end
		else
			Lighting.FogEnd = 100000
		end
	end)
end

function Hub.handleAntiRadio()
	pcall(function()
		for _, v in pairs(workspace:GetDescendants()) do
			if v:IsA("Sound") then
				local n = string.lower(v.Name)
				if string.find(n, "radio") or string.find(n, "music") or string.find(n, "broadcast") then
					v.Volume = 0
					v:Stop()
				end
			end
		end
	end)
end

function Hub.setAntiRadio(on)
	Hub.antiRadio = on
	if on then Hub.handleAntiRadio() end
end

function Hub.scanFloor()
	local name = "Unknown"
	pcall(function()
		local cf = workspace:FindFirstChild("CurrentFloor")
		if cf then
			name = cf.Name
			if cf:IsA("StringValue") or cf:IsA("NumberValue") then name = tostring(cf.Value) end
			local label = cf:FindFirstChildWhichIsA("StringValue") or cf:FindFirstChild("Name")
			if label and label.Value then name = tostring(label.Value) end
		end
		for _, v in pairs(workspace:GetChildren()) do
			local ln = string.lower(v.Name)
			if string.find(ln, "floor") and not string.find(ln, "elevator") then
				if v:IsA("Folder") or v:IsA("Model") then
					name = v.Name
					break
				end
			end
		end
	end)
	Hub.lastFloorName = name
	return name
end

function Hub.getGodUsers()
	local list = {}
	pcall(function()
		for _, plr in pairs(Players:GetPlayers()) do
			local bp = plr:FindFirstChild("Backpack")
			local char = plr.Character
			local found = false
			local function scan(parent)
				if not parent then return end
				for _, t in pairs(parent:GetChildren()) do
					local n = string.lower(t.Name)
					if string.find(n, "god") or string.find(n, "admin") or string.find(n, "immortal") then
						found = true
					end
				end
			end
			scan(bp)
			if char then scan(char) end
			if found then table.insert(list, plr.Name) end
		end
	end)
	return list
end

Hub.onFloorUpdate = Hub.onFloorUpdate or nil
Hub.onGodUpdate = Hub.onGodUpdate or nil

local lastTick = 0
RunService.Heartbeat:Connect(function()
	local now = tick()
	if now - lastTick < 0.5 then return end
	lastTick = now

	if Hub.cleanVision then
		pcall(function()
			Lighting.FogEnd = 1e6
			Lighting.FogStart = 0
		end)
	end
	if Hub.antiRadio then Hub.handleAntiRadio() end

	local floor = Hub.scanFloor()
	if Hub.onFloorUpdate then pcall(Hub.onFloorUpdate, floor) end
	if Hub.godCheckerOn and Hub.onGodUpdate then
		pcall(Hub.onGodUpdate, Hub.getGodUsers())
	end

	if Hub.killerESP then
		Hub.clearHighlights(Hub.killerHighlights)
		for _, v in pairs(workspace:GetDescendants()) do
			if v:IsA("Model") and Hub.isKiller(v) then
				Hub.applyHighlight(v, Color3.fromRGB(255, 40, 40), Hub.killerHighlights)
			end
		end
	else
		Hub.clearHighlights(Hub.killerHighlights)
	end

	if Hub.elevESP then
		Hub.clearHighlights(Hub.elevHighlights)
		for _, v in pairs(workspace:GetDescendants()) do
			if v:IsA("Model") or v:IsA("BasePart") then
				local name = string.lower(v.Name)
				if string.find(name, "elevator") or name == "lift" or name == "car" then
					Hub.applyHighlight(v, Color3.fromRGB(0, 200, 255), Hub.elevHighlights)
				end
			end
		end
	else
		Hub.clearHighlights(Hub.elevHighlights)
	end

	if Hub.mapESP then
		Hub.clearHighlights(Hub.mapHighlights)
		for _, v in pairs(workspace:GetChildren()) do
			if (v:IsA("Model") or v:IsA("Folder")) and v.Name == Hub.lastFloorName then
				Hub.applyHighlight(v, Color3.fromRGB(255, 200, 50), Hub.mapHighlights)
			end
		end
		local cf = workspace:FindFirstChild("CurrentFloor")
		if cf then Hub.applyHighlight(cf, Color3.fromRGB(255, 200, 50), Hub.mapHighlights) end
	else
		Hub.clearHighlights(Hub.mapHighlights)
	end
end)
