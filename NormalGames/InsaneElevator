local function confirmContinue()
	if game.PlaceId == ALLOWED_PLACE then
		return true
	end
	local done = false
	local result = false
	local conf = Instance.new("ScreenGui")
	conf.Name = "PlaceConfirm"
	conf.ResetOnSpawn = false
	conf.Parent = pg
	local box = Instance.new("Frame")
	box.Size = UDim2.new(0, 320, 0, 150)
	box.Position = UDim2.new(0.5, -160, 0.5, -75)
	box.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
	box.BorderSizePixel = 0
	box.Parent = conf
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 10)
	c.Parent = box
	local msg = Instance.new("TextLabel")
	msg.Size = UDim2.new(1, -20, 0, 70)
	msg.Position = UDim2.new(0, 10, 0, 12)
	msg.BackgroundTransparency = 1
	msg.Text = "This is not Insane Elevator\n(PlaceId: " .. tostring(game.PlaceId) .. ")\nContinue executing anyway?"
	msg.TextColor3 = Color3.fromRGB(255, 255, 255)
	msg.Font = Enum.Font.Gotham
	msg.TextSize = 14
	msg.TextWrapped = true
	msg.Parent = box
	local yes = Instance.new("TextButton")
	yes.Size = UDim2.new(0, 120, 0, 32)
	yes.Position = UDim2.new(0, 20, 1, -48)
	yes.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
	yes.Text = "Continue"
	yes.TextColor3 = Color3.fromRGB(255, 255, 255)
	yes.Font = Enum.Font.GothamBold
	yes.TextSize = 13
	yes.Parent = box
	local yc = Instance.new("UICorner")
	yc.CornerRadius = UDim.new(0, 6)
	yc.Parent = yes
	local no = Instance.new("TextButton")
	no.Size = UDim2.new(0, 120, 0, 32)
	no.Position = UDim2.new(1, -140, 1, -48)
	no.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	no.Text = "Cancel"
	no.TextColor3 = Color3.fromRGB(255, 255, 255)
	no.Font = Enum.Font.GothamBold
	no.TextSize = 13
	no.Parent = box
	local nc = Instance.new("UICorner")
	nc.CornerRadius = UDim.new(0, 6)
	nc.Parent = no
	yes.MouseButton1Click:Connect(function()
		result = true
		done = true
		conf:Destroy()
	end)
	no.MouseButton1Click:Connect(function()
		result = false
		done = true
		conf:Destroy()
	end)
	while not done do
		task.wait()
	end
	return result
end

