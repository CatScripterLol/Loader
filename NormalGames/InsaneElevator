local base = "https://raw.githubusercontent.com/CatScripterLol/Loader/main/NormalGames/"
local names = {"InsaneElevator_1", "InsaneElevator_2", "InsaneElevator_3", "InsaneElevator_4"}
local buf = table.create(#names)
for i, name in ipairs(names) do
	local ok, src = pcall(game.HttpGet, game, base .. name)
	if not ok or type(src) ~= "string" or src == "" then
		warn("[ElevatorHub] Failed to load ", name, src)
		return
	end
	buf[i] = src
end
local LS = loadstring or load
local fn, err = LS(table.concat(buf))
if not fn then
	warn("[ElevatorHub] assemble error: ", err)
	return
end
local ok, runErr = pcall(fn)
if not ok then
	warn("[ElevatorHub] runtime error: ", runErr)
end
