function Hub.applyHighlight(obj, color, tbl)
	if not obj or obj:FindFirstChild("ESPHighlight") then return end
	local h = Instance.new("Highlight")
	h.Name = "ESPHighlight"
	h.Adornee = obj
	h.FillColor = color
