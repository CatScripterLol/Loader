-- LOCAL_VERSION must match NormalGames/VERSION after you update
-- On mismatch: Kick (leave game). No KILL switch.
local LOCAL_VERSION = "1.0.0"
local VERSION_URL = "https://raw.githubusercontent.com/CatScripterLol/Loader/main/NormalGames/VERSION"

task.spawn(function()
	while true do
		task.wait(12)
		local ok, remote = pcall(function()
			return game:HttpGet(VERSION_URL)
		end)
		if ok and type(remote) == "string" then
			remote = (remote:gsub("%s+", ""))
			if remote ~= "" and remote ~= LOCAL_VERSION then
				pcall(function()
					game:GetService("Players").LocalPlayer:Kick(
						"ElevatorHub updated (v" .. tostring(remote) .. "). Re-execute the loadstring."
					)
				end)
				break
			end
		end
	end
end)

loadstring(game:HttpGet("https://raw.githubusercontent.com/CatScripterLol/Loader/6dca68e8ff3f20936e95826a2b0e590be21459e9/NormalGames/InsaneElevator"))()
task.wait(0.8)
pcall(function()
	loadstring(game:HttpGet("https://raw.githubusercontent.com/CatScripterLol/Loader/main/UI/PlayerESP"))()
end)
task.wait(0.3)
pcall(function()
	loadstring(game:HttpGet("https://raw.githubusercontent.com/CatScripterLol/Loader/main/UI/FarmAFK"))()
end)
