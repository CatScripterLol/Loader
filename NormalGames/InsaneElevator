function Hub.clearHighlights(tbl)
	for _, h in pairs(tbl) do
		if h and h.Parent then h:Destroy() end
	end
	table.clear(tbl)
end

function Hub.applyHighlight(obj, color, tbl)
	if not obj or obj:FindFirstChild("ESPHighlight") then return end
	local h = Instance.new("Highlight")
	h.Name = "ESPHighlight"
	h.Adornee = obj
	h.FillColor = color
	h.OutlineColor = color
	h.FillTransparency = 0.55
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = obj
	table.insert(tbl, h)
end

function Hub.isKiller(model)
	if not model:FindFirstChildOfClass("Humanoid") then return false end
	if Players:GetPlayerFromCharacter(model) then return false end
	return true
end

function Hub.applyDefaultSky()
	for _, v in pairs(Lighting:GetChildren()) do
		if v:IsA("Sky") then v:Destroy() end
	end
	local sky = Instance.new("Sky")
	sky.Name = "DefaultSky"
	sky.SkyboxBk = "rbxasset://textures/sky/sky512_bk.tex"
	sky.SkyboxDn = "rbxasset://textures/sky/sky512_dn.tex"
	sky.SkyboxFt = "rbxasset://textures/sky/sky512_ft.tex"
	sky.SkyboxLf = "rbxasset://textures/sky/sky512_lf.tex"
	sky.SkyboxRt = "rbxasset://textures/sky/sky512_rt.tex"
	sky.SkyboxUp = "rbxasset://textures/sky/sky512_up.tex"
	sky.Parent = Lighting
end

function Hub.setCleanVision(on)
	Hub.cleanVision = on
	if on then
		Hub.saved.FogEnd = Lighting.FogEnd
		Hub.saved.FogStart = Lighting.FogStart
		Hub.saved.Brightness = Lighting.Brightness
		Hub.saved.Ambient = Lighting.Ambient
		Hub.saved.OutdoorAmbient = Lighting.OutdoorAmbient
		Hub.saved.ClockTime = Lighting.ClockTime
		Hub.saved.GlobalShadows = Lighting.GlobalShadows
		for _, v in pairs(Lighting:GetChildren()) do
			if v:IsA("Sky") then Hub.savedSky = v:Clone() end
		end
		Lighting.FogEnd = math.huge
		Lighting.FogStart = 0
		Lighting.Brightness = 2
		Lighting.Ambient = Color3.fromRGB(180, 180, 180)
		Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
		Lighting.ClockTime = 14
		Lighting.GlobalShadows = false
		Hub.applyDefaultSky()
		table.clear(Hub.disabledEffects)
		for _, v in pairs(Lighting:GetChildren()) do
			if v:IsA("Atmosphere") or v:IsA("BloomEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("SunRaysEffect") then
				if v.Enabled then
					v.Enabled = false
					table.insert(Hub.disabledEffects, v)
				end
			end
		end
	else
		Lighting.FogEnd = Hub.saved.FogEnd
		Lighting.FogStart = Hub.saved.FogStart
		Lighting.Brightness = Hub.saved.Brightness
		Lighting.Ambient = Hub.saved.Ambient
		Lighting.OutdoorAmbient = Hub.saved.OutdoorAmbient
		Lighting.ClockTime = Hub.saved.ClockTime
		Lighting.GlobalShadows = Hub.saved.GlobalShadows
		local def = Lighting:FindFirstChild("DefaultSky")
		if def then def:Destroy() end
		if Hub.savedSky then
			Hub.savedSky.Parent = Lighting
			Hub.savedSky = nil
		end
		for _, v in pairs(Hub.disabledEffects) do
			if v and v.Parent then v.Enabled = true end
		end
		table.clear(Hub.disabledEffects)
	end
end

function Hub.handleAntiRadio()
	if not Hub.radioHolder or not Hub.radioHolder.Parent then
		Hub.radioHolder = Instance.new("Folder")
		Hub.radioHolder.Name = "AntiRadioHolder"
		Hub.radioHolder.Parent = pg
	end
	for _, plr in pairs(Players:GetPlayers()) do
		local containers = {plr:FindFirstChild("Backpack"), plr.Character}
		for _, container in pairs(containers) do
			if container then
				for _, item in pairs(container:GetChildren()) do
					local n = string.lower(item.Name)
					if n == "radio" or string.find(n, "radio") then
						for _, d in pairs(item:GetDescendants()) do
							if d:IsA("Sound") then
								if Hub.mutedSounds[d] == nil then
									Hub.mutedSounds[d] = {Volume = d.Volume, Playing = d.Playing}
								end
								d.Volume = 0
								d:Stop()
							end
						end
						if not Hub.hiddenRadios[item] then
							Hub.hiddenRadios[item] = container
							item.Parent = Hub.radioHolder
						end
					end
				end
			end
		end
	end
	for _, d in pairs(workspace:GetDescendants()) do
		if d:IsA("Sound") then
			local n = string.lower(d.Name)
			local p = d.Parent and string.lower(d.Parent.Name) or ""
			if string.find(n, "radio") or string.find(p, "radio") then
				if Hub.mutedSounds[d] == nil then
					Hub.mutedSounds[d] = {Volume = d.Volume, Playing = d.Playing}
				end
				d.Volume = 0
				d:Stop()
			end
		end
	end
end

function Hub.setAntiRadio(on)
	Hub.antiRadio = on
	if not on then
		for snd, data in pairs(Hub.mutedSounds) do
			if snd and snd.Parent then
				snd.Volume = data.Volume
				snd.Playing = data.Playing
			end
		end
		table.clear(Hub.mutedSounds)
		for tool, parent in pairs(Hub.hiddenRadios) do
			if tool and parent and parent.Parent then
				tool.Parent = parent
			end
		end
		table.clear(Hub.hiddenRadios)
	end
end

function Hub.hasGodMode(plr)
	local ok, result = pcall(function()
		local bp = plr:FindFirstChild("Backpack")
		if bp and bp:FindFirstChild("God Mode") then return true end
		local char = plr.Character
		if char and char:FindFirstChild("God Mode") then return true end
		return false
	end)
	return ok and result
end

function Hub.getGodUsers()
	local names = {}
	for _, plr in pairs(Players:GetPlayers()) do
		if Hub.hasGodMode(plr) then
			table.insert(names, plr.Name)
		end
	end
	return names
end

function Hub.scanFloor()
	local result = nil
	for _, v in pairs(workspace:GetChildren()) do
		if v:IsA("Model") or v:IsA("Folder") then
			local n = v.Name
			local ln = string.lower(n)
			if ln ~= "elevator" and ln ~= "baseplate" and ln ~= "camera" and ln ~= "terrain"
				and not Players:FindFirstChild(n)
				and not string.find(ln, "spawn") and not string.find(ln, "lobby")
				and not string.find(ln, "shop") and not string.find(ln, "vip") and #n > 2 then
				if v:FindFirstChildOfClass("Humanoid") or v:FindFirstChild("Map") or v:FindFirstChild("Floor")
					or string.find(ln, "floor") or string.find(ln, "map") or string.find(ln, "stage")
					or string.find(ln, "killer") or string.find(ln, "alien") or string.find(ln, "granny")
					or string.find(ln, "jeff") or string.find(ln, "scp") or string.find(ln, "siren")
					or string.find(ln, "slender") or string.find(ln, "piggy") or string.find(ln, "cartoon")
					or string.find(ln, "freddy") or string.find(ln, "penny") or string.find(ln, "rake")
					or string.find(ln, "baldi") or string.find(ln, "imposter") or string.find(ln, "among")
					or string.find(ln, "white") or string.find(ln, "troll") or string.find(ln, "sonic")
					or string.find(ln, "trex") or string.find(ln, "terminator") or string.find(ln, "john") then
					result = n
				end
			end
		end
	end
	if not result then
		local cf = workspace:FindFirstChild("CurrentFloor")
		if cf then result = cf.Name end
	end
	if not result then
		for _, v in pairs(pg:GetDescendants()) do
			if (v:IsA("TextLabel") or v:IsA("TextButton")) and v.Text then
				local t = v.Text
				local match = string.match(t, "[Ff]loor%s*[#:]?%s*(%d+)")
				if match then
					result = "Floor " .. match
				elseif string.find(string.lower(t), "floor") and #t < 30 and #t > 3 then
					result = t
				end
			end
		end
	end
	if result and result ~= Hub.lastFloorName then
		Hub.lastFloorName = result
	end
	return Hub.lastFloorName
end

workspace.ChildAdded:Connect(function(child)
	task.wait(0.3)
	local n = string.lower(child.Name)
	if child:IsA("Model") or child:IsA("Folder") then
		if not string.find(n, "elevator") and not string.find(n, "spawn") and not Players:FindFirstChild(child.Name) then
			Hub.lastFloorName = child.Name
			if Hub.onFloorUpdate then Hub.onFloorUpdate(child.Name) end
		end
	end
end)

local lastUpdate = 0
RunService.Heartbeat:Connect(function()
	local now = tick()
	if now - lastUpdate < 0.5 then return end
	lastUpdate = now

	if Hub.cleanVision then
		Lighting.FogEnd = math.huge
		Lighting.FogStart = 0
		if not Lighting:FindFirstChild("DefaultSky") then Hub.applyDefaultSky() end
		for _, v in pairs(Lighting:GetChildren()) do
			if v:IsA("Sky") and v.Name ~= "DefaultSky" then v:Destroy() end
		end
	end

	if Hub.antiRadio then
		Hub.handleAntiRadio()
	end

	local floor = Hub.scanFloor()
	if Hub.onFloorUpdate then Hub.onFloorUpdate(floor) end
	if Hub.godCheckerOn and Hub.onGodUpdate then
		Hub.onGodUpdate(Hub.getGodUsers())
	end

	if Hub.killerESP then
		Hub.clearHighlights(Hub.killerHighlights)
		for _, v in pairs(workspace:GetDescendants()) do
			if v:IsA("Model") and Hub.isKiller(v) then
				Hub.applyHighlight(v, Color3.fromRGB(255, 40, 40), Hub.killerHighlights)
			end
		end
	end

	if Hub.elevESP then
		Hub.clearHighlights(Hub.elevHighlights)
		for _, v in pairs(workspace:GetDescendants()) do
			if v:IsA("Model") or v:IsA("BasePart") then
				local name = string.lower(v.Name)
				if string.find(name, "elevator") or name == "lift" or name == "car" then
					Hub.applyHighlight(v, Color3.fromRGB(0, 200, 255), Hub.elevHighlights)
				end
			end
		end
	end

	if Hub.mapESP then
		Hub.clearHighlights(Hub.mapHighlights)
		for _, v in pairs(workspace:GetChildren()) do
			if (v:IsA("Model") or v:IsA("Folder")) and v.Name == Hub.lastFloorName then
				Hub.applyHighlight(v, Color3.fromRGB(255, 200, 50), Hub.mapHighlights)
			elseif v:IsA("Model") or v:IsA("Folder") then
				local ln = string.lower(v.Name)
				if (string.find(ln, "floor") or string.find(ln, "map") or string.find(ln, "stage"))
					and not Players:FindFirstChild(v.Name) and ln ~= "elevator" then
					Hub.applyHighlight(v, Color3.fromRGB(255, 200, 50), Hub.mapHighlights)
				end
			end
		end
		local cf = workspace:FindFirstChild("CurrentFloor")
		if cf then Hub.applyHighlight(cf, Color3.fromRGB(255, 200, 50), Hub.mapHighlights) end
	end
end)

local uiUrl = "https://raw.githubusercontent.com/CatScripterLol/Loader/main/UI/InsaneElevator"
local LS = loadstring or load
local ok, src = pcall(function()
	return game:HttpGet(uiUrl)
end)
if not ok or type(src) ~= "string" or src == "" then
	warn("[ElevatorHub] Failed to download UI: ", src)
	return
end
if not LS then
	warn("[ElevatorHub] loadstring/load is nil")
	return
end
local fn, err = LS(src)
if not fn then
	warn("[ElevatorHub] UI loadstring error: ", err)
	return
end
local ran, runErr = pcall(fn)
if not ran then
	warn("[ElevatorHub] UI runtime error: ", runErr)
end
