local base = "https://raw.githubusercontent.com/CatScripterLol/Loader/main/NormalGames/"
local parts = {"InsaneElevator_1","InsaneElevator_2","InsaneElevator_3","InsaneElevator_4"}
local buf = {}
for _, name in ipairs(parts) do
	local ok, src = pcall(function()
		return game:HttpGet(base .. name)
	end)
	if not ok or type(src) ~= "string" or src == "" then
		warn("[ElevatorHub] Failed chunk: ", name, src)
		return
	end
	table.insert(buf, src)
end
local LS = loadstring or load
local fn, err = LS(table.concat(buf))
if not fn then
	warn("[ElevatorHub] assemble error: ", err)
	return
end
local ok, runErr = pcall(fn)
if not ok then
	warn("[ElevatorHub] runtime error: ", runErr)
end
