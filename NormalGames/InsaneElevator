		p.BackgroundTransparency = 0.3
		p.BorderSizePixel = 0
		p.Parent = bg
		local pc = Instance.new("UICorner")
		pc.CornerRadius = UDim.new(1, 0)
		pc.Parent = p
		particles[i] = {
			frame = p,
			angle = math.random() * math.pi * 2,
			radius = 35 + math.random() * 80,
			speed = 0.35 + math.random() * 0.7,
			yOff = (math.random() - 0.5) * 60
		}
	end

	TweenService:Create(title, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
	TweenService:Create(sub, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
	TweenService:Create(pctLabel, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()

	local duration = 2 + math.random() * 2
	local t0 = tick()
	local skipRequested = false
	local finished = false

	skipBtn.MouseButton1Click:Connect(function()
		if not skipBtn.Visible then return end
		skipRequested = true
	end)

	local conn
	conn = RunService.RenderStepped:Connect(function()
		if finished then return end
		local now = tick()
		local elapsed = now - t0
		local progress = math.clamp(elapsed / duration, 0, 1)
		if skipRequested and progress >= 0.4 then
			progress = 1
		end
		local pct = math.floor(progress * 100)
		pctLabel.Text = pct .. "%"
		bar.Size = UDim2.new(progress, 0, 1, 0)

		local pulse = 0.55 + 0.45 * math.sin(elapsed * 3.6)
		bar.BackgroundColor3 = Color3.fromRGB(70 + 50 * pulse, 140 + 40 * pulse, 255)
		coreGlow.Transparency = 0.25 + 0.3 * (1 - pulse)
		core.Size = UDim2.new(0, 14 + 5 * pulse, 0, 14 + 5 * pulse)

		for _, r in ipairs(rings) do
			r.base = r.base + r.speed * 1.7
			r.frame.Rotation = r.base
		end

		for _, p in ipairs(particles) do
			p.angle = p.angle + p.speed * 0.022
			local x = 0.5 + math.cos(p.angle) * (p.radius / 900)
			local y = 0.58 + math.sin(p.angle) * (p.radius / 900) + p.yOff / 900
			p.frame.Position = UDim2.new(x, 0, y, 0)
			p.frame.BackgroundTransparency = 0.25 + 0.4 * math.abs(math.sin(p.angle * 2))
		end

		if progress >= 0.4 and not skipBtn.Visible then
			skipBtn.Visible = true
			skipBtn.TextColor3 = Color3.fromRGB(220, 230, 255)
			skipBtn.BackgroundColor3 = Color3.fromRGB(55, 70, 110)
		end

		if progress >= 1 then
			finished = true
		end
	end)

	while not finished do
		task.wait()
	end
	if conn then conn:Disconnect() end

	local fade = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(bg, fade, {BackgroundTransparency = 1}):Play()
	TweenService:Create(title, fade, {TextTransparency = 1}):Play()
	TweenService:Create(sub, fade, {TextTransparency = 1}):Play()
	TweenService:Create(pctLabel, fade, {TextTransparency = 1}):Play()
	TweenService:Create(barBg, fade, {BackgroundTransparency = 1}):Play()
	TweenService:Create(bar, fade, {BackgroundTransparency = 1}):Play()
	TweenService:Create(core, fade, {BackgroundTransparency = 1}):Play()
	TweenService:Create(skipBtn, fade, {BackgroundTransparency = 1, TextTransparency = 1}):Play()
	for _, r in ipairs(rings) do
		local s = r.frame:FindFirstChildOfClass("UIStroke")
		if s then TweenService:Create(s, fade, {Transparency = 1}):Play() end
	end
	for _, p in ipairs(particles) do
		TweenService:Create(p.frame, fade, {BackgroundTransparency = 1}):Play()
	end
	task.wait(0.4)
	loadGui:Destroy()
end

