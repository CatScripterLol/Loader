-- LOCAL_VERSION must match NormalGames/VERSION after you update (soft-stop only, no game kick)
local LOCAL_VERSION = "1.0.0"
local VERSION_URL = "https://raw.githubusercontent.com/CatScripterLol/Loader/main/NormalGames/VERSION"

local function softStopHub(reason)
	pcall(function()
		local env = (typeof(getgenv) == "function" and getgenv()) or _G
		local Hub = env.ElevatorHub
		if Hub then
			Hub.autoFarm = false
			Hub.playerESP = false
			Hub.killerESP = false
			Hub.elevESP = false
			Hub.mapESP = false
			Hub.antiAfk = false
		end
	end)
	pcall(function()
		local pg = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
		if not pg then return end
		for _, name in ipairs({"ElevatorTP", "ElevatorWho", "ElevatorLoading", "FloorPredictor", "GodModeChecker"}) do
			local g = pg:FindFirstChild(name)
			if g then g:Destroy() end
		end
	end)
	warn("[ElevatorHub] ", reason or "Script updated — re-execute the loadstring. You were NOT kicked from the game.")
end

task.spawn(function()
	while true do
		task.wait(12)
		local ok, remote = pcall(function()
			return game:HttpGet(VERSION_URL)
		end)
		if ok and type(remote) == "string" then
			remote = (remote:gsub("%s+", ""))
			if remote ~= "" and remote ~= LOCAL_VERSION then
				softStopHub("Hub updated (v" .. tostring(remote) .. "). Re-execute loadstring. Streak safe — not kicked.")
				break
			end
		end
	end
end)

loadstring(game:HttpGet("https://raw.githubusercontent.com/CatScripterLol/Loader/6dca68e8ff3f20936e95826a2b0e590be21459e9/NormalGames/InsaneElevator"))()
task.wait(0.8)
pcall(function()
	loadstring(game:HttpGet("https://raw.githubusercontent.com/CatScripterLol/Loader/main/UI/PlayerESP"))()
end)
task.wait(0.3)
pcall(function()
	loadstring(game:HttpGet("https://raw.githubusercontent.com/CatScripterLol/Loader/main/UI/FarmAFK"))()
end)
