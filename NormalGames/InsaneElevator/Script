	Hub.clearHighlights(Hub.mapHighlights)
	Hub.clearHighlights(Hub.playerHighlights)
	stopFarmTween()
	destroyPlatform()
end)

local lastTick = 0
RunService.Heartbeat:Connect(function()
	if tick() - lastTick < 0.45 then return end
	lastTick = tick()
	if Hub.cleanVision then pcall(function() Lighting.FogEnd, Lighting.FogStart = 1e6, 0 end) end
	if Hub.antiRadio then
		pcall(function()
			for _, v in pairs(workspace:GetDescendants()) do
				if v:IsA("Sound") then
					local n = string.lower(v.Name)
					if string.find(n, "radio") or string.find(n, "music") then v.Volume = 0 v:Stop() end
				end
			end
		end)
	end
	local floor = Hub.scanFloor()
	if Hub.onFloorUpdate then pcall(Hub.onFloorUpdate, floor) end
	if Hub.godCheckerOn and Hub.onGodUpdate then pcall(Hub.onGodUpdate, Hub.getGodUsers()) end
	if Hub.killerESP then
		Hub.clearHighlights(Hub.killerHighlights)
		for _, v in pairs(workspace:GetDescendants()) do
			if v:IsA("Model") and Hub.isKiller(v) then Hub.applyHighlight(v, Color3.fromRGB(255, 40, 40), Hub.killerHighlights) end
		end
	else Hub.clearHighlights(Hub.killerHighlights) end
	if Hub.elevESP then
		Hub.clearHighlights(Hub.elevHighlights)
		for _, v in pairs(workspace:GetDescendants()) do
			local n = string.lower(v.Name)
			if (v:IsA("Model") or v:IsA("BasePart")) and (string.find(n, "elevator") or n == "lift") then
				Hub.applyHighlight(v, Color3.fromRGB(0, 200, 255), Hub.elevHighlights)
			end
		end
	else Hub.clearHighlights(Hub.elevHighlights) end
	if Hub.mapESP then
		Hub.clearHighlights(Hub.mapHighlights)
		local cf = workspace:FindFirstChild("CurrentFloor")
		if cf then Hub.applyHighlight(cf, Color3.fromRGB(255, 200, 50), Hub.mapHighlights) end
	else Hub.clearHighlights(Hub.mapHighlights) end
	if Hub.playerESP then
		for _, plr in pairs(Players:GetPlayers()) do
			if plr ~= player and plr.Character then
				Hub.applyHighlight(plr.Character, Color3.fromRGB(60, 180, 255), Hub.playerHighlights)
			end
		end
	else Hub.clearHighlights(Hub.playerHighlights) end
end)

