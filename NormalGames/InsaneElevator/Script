function Hub.clearHighlights(t)
	if type(t) ~= "table" then return end
	for _, h in pairs(t) do pcall(function() if h then h:Destroy() end end) end
	table.clear(t)
end
function Hub.applyHighlight(obj, color, t)
	if not obj or not obj.Parent or obj:FindFirstChild("ESPHighlight") then return end
	local h = Instance.new("Highlight")
	h.Name, h.Adornee, h.FillColor, h.OutlineColor = "ESPHighlight", obj, color, color
	h.FillTransparency, h.OutlineTransparency = 0.55, 0
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = obj
	table.insert(t, h)
end
function Hub.teleport(pos)
	pcall(function()
		local c = player.Character or player.CharacterAdded:Wait()
		local r = c:FindFirstChild("HumanoidRootPart") or c:WaitForChild("HumanoidRootPart", 3)
		if r then r.CFrame = CFrame.new(pos) end
	end)
end
function Hub.isKiller(m)
	if not m or not m:IsA("Model") then return false end
	if Players:FindFirstChild(m.Name) then return false end
	local n = string.lower(m.Name)
	if string.find(n, "killer") or string.find(n, "enemy") then return true end
	if m:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(m) then
		if string.find(n, "boss") or string.find(n, "monster") or string.find(n, "entity") then return true end
	end
	return false
end
function Hub.setCleanVision(on)
	Hub.cleanVision = on
	pcall(function()
		if on then Lighting.FogEnd, Lighting.FogStart, Lighting.Brightness = 1e6, 0, 2
		else Lighting.FogEnd = 100000 end
	end)
end
function Hub.setAntiRadio(on)
	Hub.antiRadio = on
end
function Hub.scanFloor()
	local name = "Unknown"
	pcall(function()
		local cf = workspace:FindFirstChild("CurrentFloor")
		if cf then name = (cf.Value and tostring(cf.Value)) or cf.Name end
		for _, v in pairs(workspace:GetChildren()) do
			local ln = string.lower(v.Name)
			if string.find(ln, "floor") and not string.find(ln, "elevator") and (v:IsA("Folder") or v:IsA("Model")) then
				name = v.Name break
			end
		end
	end)
	Hub.lastFloorName = name
	return name
end
function Hub.getGodUsers()
	local list = {}
	for _, plr in pairs(Players:GetPlayers()) do
		local found = false
		local function scan(p)
			if not p then return end
			for _, t in pairs(p:GetChildren()) do
				local n = string.lower(t.Name)
				if string.find(n, "god") or string.find(n, "admin") then found = true end
			end
		end
		scan(plr:FindFirstChild("Backpack"))
		scan(plr.Character)
		if found then table.insert(list, plr.Name) end
	end
	return list
end

local platform, platformConn, farmRunning, afkConn
local function destroyPlatform()
	if platformConn then pcall(function() platformConn:Disconnect() end) platformConn = nil end
	if platform then pcall(function() platform:Destroy() end) platform = nil end
end
local function ensurePlatform()
	if platform and platform.Parent then return end
	destroyPlatform()
	local p = Instance.new("Part")
	p.Name, p.Size, p.Anchored, p.CanCollide = "ElevatorFarmPlatform", Vector3.new(14, 1, 14), true, true
	p.Transparency, p.Color, p.Material, p.CastShadow = 0.35, Color3.fromRGB(70, 110, 255), Enum.Material.SmoothPlastic, false
	p.Parent = workspace
	platform = p
	platformConn = RunService.Heartbeat:Connect(function()
		if not Hub.autoFarm then destroyPlatform() return end
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if hrp and platform then platform.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - 3.2, hrp.Position.Z) end
	end)
end
local function stopFarmTween()
	if Hub._farmTween then pcall(function() Hub._farmTween:Cancel() end) Hub._farmTween = nil end
end
local function stopAutoFarm()
	Hub.autoFarm, farmRunning = false, false
	stopFarmTween()
	destroyPlatform()
end
local function clampSpeed(n)
	n = tonumber(n) or 25
	return math.clamp(math.floor(n + 0.5), 25, 50)
end
local function farmOnce()
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then task.wait(0.5) return end
	ensurePlatform()
	local target = Vector3.new(math.random(1, 100), 1820, math.random(100, 400))
	local speed = clampSpeed(Hub.farmSpeed)
	Hub.farmSpeed = speed
	local t = math.clamp((hrp.Position - target).Magnitude / speed, 1, 120)
	stopFarmTween()
	local tw = TweenService:Create(hrp, TweenInfo.new(t, Enum.EasingStyle.Linear), {CFrame = CFrame.new(target)})
	Hub._farmTween = tw
	local done = false
	local c; c = tw.Completed:Connect(function() done = true if c then c:Disconnect() end end)
	tw:Play()
	local t0 = tick()
	while not done and Hub.autoFarm and farmRunning do
		if not hrp.Parent or tick() - t0 > t + 2 then break end
		task.wait(0.1)
	end
	stopFarmTween()
end
local function startAutoFarm()
	if farmRunning then return end
	farmRunning = true
	ensurePlatform()
	task.spawn(function()
		while Hub.autoFarm and farmRunning do
			pcall(farmOnce)
			if not Hub.autoFarm then break end
			task.wait(0.25)
		end
		farmRunning = false
		stopFarmTween()
		destroyPlatform()
	end)
end
local function setAntiAfk(on)
	Hub.antiAfk = on
	if afkConn then pcall(function() afkConn:Disconnect() end) afkConn = nil end
	if on then
		afkConn = player.Idled:Connect(function()
			pcall(function() VirtualUser:CaptureController() VirtualUser:ClickButton2(Vector2.new()) end)
		end)
	end
end

player.CharacterRemoving:Connect(function()
	Hub.clearHighlights(Hub.killerHighlights)
