local function execSrc(src)
	if type(src) ~= "string" or src == "" then return false end
	local LS = loadstring or load
	if not LS then return false end
	local fn, err = LS(src)
	if not fn then
		warn("[ElevatorHub] compile error: ", err)
		return false
	end
	local ran, runErr = pcall(fn)
	if not ran then
		warn("[ElevatorHub] runtime error: ", runErr)
		return false
	end
	return true
end

local function fetch(url)
	local ok, src = pcall(function()
		return game:HttpGet(url)
	end)
	if ok and type(src) == "string" and src ~= "" then return src end
	return nil
end

pcall(function()
	pg.ChildAdded:Connect(function(c)
		if c.Name == "ElevatorLoading" then
			task.defer(function()
				pcall(function() c:Destroy() end)
			end)
		end
	end)
end)

local urls = {
	CORE,
	BASE .. "UI/InsaneElevator",
	BASE .. "UI/RespawnFix",
	BASE .. "UI/PlayerESP",
	BASE .. "UI/FarmAFK",
}
local sources = {}
local pending = #urls
for i, url in ipairs(urls) do
	task.spawn(function()
		sources[i] = fetch(url)
		pending = pending - 1
	end)
end
local t0 = tick()
while pending > 0 and tick() - t0 < 15 do
	task.wait()
end

execSrc(sources[1])
if not pg:FindFirstChild("ElevatorTP") then
	execSrc(sources[2])
end
execSrc(sources[3])
execSrc(sources[4])
