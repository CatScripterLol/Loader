local LOCAL_VERSION = "1.0.5"
local VERSION_URL = "https://raw.githubusercontent.com/CatScripterLol/Loader/main/NormalGames/InsaneElevator/VERSION"
local BASE = "https://raw.githubusercontent.com/CatScripterLol/Loader/main/NormalGames/InsaneElevator/"

local function checkVersion()
	local ok, remote = pcall(function()
		return game:HttpGet(VERSION_URL .. "?t=" .. tostring(tick()) .. "&r=" .. tostring(math.random(1, 999999999)))
	end)
	if not ok or type(remote) ~= "string" then return false end
	remote = remote:gsub("%s+", "")
	if remote ~= "" and remote ~= LOCAL_VERSION then
		pcall(function()
			game:GetService("Players").LocalPlayer:Kick(
				"ElevatorHub updated (v" .. tostring(remote) .. "). Re-execute the loadstring."
			)
		end)
		return true
	end
	return false
end

if checkVersion() then return end

task.spawn(function()
	while true do
		task.wait(8)
		if checkVersion() then break end
	end
end)

local function runUrl(url)
	local ok, src = pcall(function()
		return game:HttpGet(url)
	end)
	if not ok or type(src) ~= "string" or src == "" then
		warn("[ElevatorHub] download failed: ", url, src)
		return false
	end
	local LS = loadstring or load
	if not LS then
		warn("[ElevatorHub] loadstring is nil")
		return false
	end
	local fn, err = LS(src)
	if not fn then
		warn("[ElevatorHub] compile error: ", err)
		return false
	end
	local ran, runErr = pcall(fn)
	if not ran then
		warn("[ElevatorHub] runtime error: ", runErr)
		return false
	end
	return true
end

runUrl("https://raw.githubusercontent.com/CatScripterLol/Loader/6dca68e8ff3f20936e95826a2b0e590be21459e9/NormalGames/InsaneElevator")
task.wait(0.4)
if not game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui") or not game:GetService("Players").LocalPlayer.PlayerGui:FindFirstChild("ElevatorTP") then
	runUrl(BASE .. "UI/InsaneElevator")
end
task.wait(0.15)
runUrl(BASE .. "UI/RespawnFix")
task.wait(0.15)
runUrl(BASE .. "UI/PlayerESP")
task.wait(0.15)
runUrl(BASE .. "UI/FarmAFK")
