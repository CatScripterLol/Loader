local LOCAL_VERSION = "1.3.1"
local VERSION_URL = "https://raw.githubusercontent.com/CatScripterLol/Loader/main/NormalGames/InsaneElevator/VERSION"
local BASE = "https://raw.githubusercontent.com/CatScripterLol/Loader/main/NormalGames/InsaneElevator/"

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")

local function checkVersion()
	local ok, remote = pcall(function()
		return game:HttpGet(VERSION_URL .. "?t=" .. tostring(tick()) .. "&r=" .. tostring(math.random(1, 999999999)))
	end)
	if not ok or type(remote) ~= "string" then return false end
	remote = remote:gsub("%s+", "")
	if remote ~= "" and remote ~= LOCAL_VERSION then
		pcall(function()
			player:Kick("ElevatorHub updated (v" .. tostring(remote) .. "). Re-execute the loadstring.")
		end)
		return true
	end
	return false
end

if checkVersion() then return end
task.spawn(function()
	while true do
		task.wait(1)
		if checkVersion() then break end
	end
end)

local function tween(obj, ti, props)
	local t = TweenService:Create(obj, ti, props)
	t:Play()
	return t
end

local function runLoading()
	local done, skipped = false, false
	local duration = 4 + math.random() * 4
	local gui = Instance.new("ScreenGui")
	gui.Name, gui.IgnoreGuiInset, gui.ResetOnSpawn, gui.DisplayOrder = "ElevatorBoot", true, false, 9999
	gui.Parent = pg
	local panel = Instance.new("Frame")
	panel.Size, panel.Position = UDim2.new(1, 0, 1, 0), UDim2.new(1, 0, 0, 0)
	panel.BackgroundColor3, panel.BorderSizePixel, panel.Parent = Color3.fromRGB(10, 10, 16), 0, gui
	local accent = Instance.new("Frame")
	accent.Size, accent.BackgroundColor3, accent.BorderSizePixel, accent.Parent = UDim2.new(0, 4, 1, 0), Color3.fromRGB(90, 120, 255), 0, panel
	local title = Instance.new("TextLabel")
	title.Size, title.Position, title.BackgroundTransparency = UDim2.new(1, -40, 0, 36), UDim2.new(0, 28, 0.38, 0), 1
	title.Text, title.TextColor3, title.Font, title.TextSize = "ElevatorHub", Color3.fromRGB(255, 255, 255), Enum.Font.GothamBold, 32
	title.TextXAlignment, title.Parent = Enum.TextXAlignment.Left, panel
	local sub = Instance.new("TextLabel")
	sub.Size, sub.Position, sub.BackgroundTransparency = UDim2.new(1, -40, 0, 22), UDim2.new(0, 28, 0.38, 40), 1
	sub.Text, sub.TextColor3, sub.Font, sub.TextSize = "Insane Elevator", Color3.fromRGB(130, 140, 170), Enum.Font.Gotham, 16
	sub.TextXAlignment, sub.Parent = Enum.TextXAlignment.Left, panel
	local status = Instance.new("TextLabel")
	status.Size, status.Position, status.BackgroundTransparency = UDim2.new(0.6, 0, 0, 18), UDim2.new(0, 28, 0.55, 0), 1
	status.Text, status.TextColor3, status.Font, status.TextSize = "Preparing...", Color3.fromRGB(160, 165, 190), Enum.Font.Gotham, 14
	status.TextXAlignment, status.Parent = Enum.TextXAlignment.Left, panel
	local pct = Instance.new("TextLabel")
	pct.Size, pct.Position, pct.BackgroundTransparency = UDim2.new(0, 70, 0, 18), UDim2.new(1, -100, 0.55, 0), 1
	pct.Text, pct.TextColor3, pct.Font, pct.TextSize = "0%", Color3.fromRGB(210, 215, 240), Enum.Font.GothamBold, 14
	pct.TextXAlignment, pct.Parent = Enum.TextXAlignment.Right, panel
	local barBg = Instance.new("Frame")
	barBg.Size, barBg.Position = UDim2.new(1, -56, 0, 10), UDim2.new(0, 28, 0.55, 28)
	barBg.BackgroundColor3, barBg.BorderSizePixel, barBg.Parent = Color3.fromRGB(32, 32, 48), 0, panel
	Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)
	local bar = Instance.new("Frame")
	bar.Size, bar.BackgroundColor3, bar.BorderSizePixel, bar.Parent = UDim2.new(0, 0, 1, 0), Color3.fromRGB(90, 120, 255), 0, barBg
	Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
	local skip = Instance.new("TextButton")
	skip.Size, skip.Position = UDim2.new(0, 90, 0, 32), UDim2.new(0.5, -45, 0.72, 0)
	skip.BackgroundColor3, skip.Text, skip.TextColor3 = Color3.fromRGB(40, 40, 58), "Skip", Color3.fromRGB(210, 210, 230)
	skip.Font, skip.TextSize, skip.Visible, skip.Parent = Enum.Font.GothamBold, 13, false, panel
	Instance.new("UICorner", skip).CornerRadius = UDim.new(0, 8)
	tween(panel, TweenInfo.new(0.55, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}).Completed:Wait()
	local messages = {"Preparing...", "Loading modules...", "Almost ready...", "Finishing..."}
	local start, progress = tick(), 0
	skip.MouseButton1Click:Connect(function()
		if progress >= 0.4 then skipped, done = true, true end
	end)
	while not done do
		progress = math.clamp((tick() - start) / duration, 0, 1)
		if skipped then progress = 1 end
		bar.Size = UDim2.new(progress, 0, 1, 0)
		pct.Text = math.floor(progress * 100) .. "%"
		status.Text = messages[math.clamp(math.floor(progress * #messages) + 1, 1, #messages)]
		skip.Visible = progress >= 0.4
		if progress >= 1 then done = true end
		task.wait()
	end
	tween(panel, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Position = UDim2.new(-1, 0, 0, 0)}).Completed:Wait()
	gui:Destroy()
end

