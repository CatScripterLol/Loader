	gui:Destroy()
	return result
end

runLoading()
if not runTerms() then
	pcall(function() player:Kick("You clicked Disagree, so you will not be able to use this script.") end)
	return
end

local function runUrl(url)
	local ok, src = pcall(function() return game:HttpGet(url) end)
	if not ok or type(src) ~= "string" or src == "" then
		warn("[ElevatorHub] download failed: ", url)
		return false
	end
	local LS = loadstring or load
	if not LS then return false end
	local fn, err = LS(src)
	if not fn then warn("[ElevatorHub] compile: ", err) return false end
	local ran, runErr = pcall(fn)
	if not ran then warn("[ElevatorHub] runtime: ", runErr) return false end
	return true
end

runUrl(BASE .. "Main")
runUrl(BASE .. "UI/InsaneElevator")
