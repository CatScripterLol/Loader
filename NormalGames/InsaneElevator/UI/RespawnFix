local env = (typeof(getgenv) == "function" and getgenv()) or _G
local Hub = env.ElevatorHub
if not Hub then return end

local Players = game:GetService("Players")
local localPlayer = Hub.player or Players.LocalPlayer

local function safeClear(tbl)
	if type(tbl) ~= "table" then return end
	for _, h in pairs(tbl) do
		pcall(function()
			if h and h.Destroy then h:Destroy() end
		end)
	end
	table.clear(tbl)
end

Hub.clearHighlights = safeClear

local oldTeleport = Hub.teleport
Hub.teleport = function(pos)
	pcall(function()
		local char = localPlayer.Character or localPlayer.CharacterAdded:Wait()
		local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 3)
		if hrp then
			hrp.CFrame = CFrame.new(pos)
		end
	end)
end

local function onCharRemoving()
	safeClear(Hub.killerHighlights)
	safeClear(Hub.elevHighlights)
	safeClear(Hub.mapHighlights)
	safeClear(Hub.playerHighlights)
	if Hub._farmTween then
		pcall(function() Hub._farmTween:Cancel() end)
		Hub._farmTween = nil
	end
end

local function onCharAdded()
	task.wait(0.3)
	safeClear(Hub.killerHighlights)
	safeClear(Hub.elevHighlights)
	safeClear(Hub.mapHighlights)
	safeClear(Hub.playerHighlights)
end

localPlayer.CharacterRemoving:Connect(onCharRemoving)
localPlayer.CharacterAdded:Connect(onCharAdded)
if localPlayer.Character then
	local hum = localPlayer.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.Died:Connect(onCharRemoving)
	end
end
localPlayer.CharacterAdded:Connect(function(char)
	task.defer(function()
		local hum = char:WaitForChild("Humanoid", 5)
		if hum then
			hum.Died:Connect(onCharRemoving)
		end
	end)
end)
