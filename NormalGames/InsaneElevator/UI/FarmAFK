local env = (typeof(getgenv) == "function" and getgenv()) or _G
local Hub = env.ElevatorHub
if not Hub then return end

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local localPlayer = Hub.player or Players.LocalPlayer
local pg = Hub.pg or localPlayer:WaitForChild("PlayerGui")

Hub.antiAfk = Hub.antiAfk or false
Hub.autoFarm = Hub.autoFarm or false
Hub.farmSpeed = Hub.farmSpeed or 25
Hub._farmTween = nil

local platform
local platformConn

local function destroyPlatform()
	if platformConn then
		pcall(function() platformConn:Disconnect() end)
		platformConn = nil
	end
	if platform then
		pcall(function() platform:Destroy() end)
		platform = nil
	end
end

local function ensurePlatform()
	if platform and platform.Parent then return platform end
	destroyPlatform()
	local p = Instance.new("Part")
	p.Name = "ElevatorFarmPlatform"
	p.Size = Vector3.new(14, 1, 14)
	p.Anchored = true
	p.CanCollide = true
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 0.35
	p.Material = Enum.Material.SmoothPlastic
	p.Color = Color3.fromRGB(70, 110, 255)
	p.CastShadow = false
	p.Parent = workspace
	platform = p
	platformConn = RunService.Heartbeat:Connect(function()
		if not Hub.autoFarm then
			destroyPlatform()
			return
		end
		local char = localPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp and platform and platform.Parent then
			platform.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - 3.2, hrp.Position.Z)
		end
	end)
	return platform
end

local afkConn
local function setAntiAfk(on)
	Hub.antiAfk = on
	if afkConn then
		pcall(function() afkConn:Disconnect() end)
		afkConn = nil
	end
	if on then
		afkConn = localPlayer.Idled:Connect(function()
			pcall(function()
				VirtualUser:CaptureController()
				VirtualUser:ClickButton2(Vector2.new())
			end)
		end)
	end
end

local function clampSpeed(n)
	n = tonumber(n)
	if not n then return 25 end
	if n < 25 then return 25 end
	if n > 50 then return 50 end
	return math.floor(n + 0.5)
end

local function getHRP()
	local char = localPlayer.Character
	if not char then return nil end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp and hrp.Parent then return hrp end
	return nil
end

local function randomFarmPos()
	return Vector3.new(
		math.random(1, 100),
		1820,
		math.random(100, 400)
	)
end

local farmRunning = false
local function stopFarmTween()
	if Hub._farmTween then
		pcall(function() Hub._farmTween:Cancel() end)
		Hub._farmTween = nil
	end
end

local function farmOnce()
	local hrp = getHRP()
	if not hrp then
		task.wait(0.5)
		return
	end
	ensurePlatform()
	local target = randomFarmPos()
	local speed = clampSpeed(Hub.farmSpeed)
	Hub.farmSpeed = speed
	local dist = (hrp.Position - target).Magnitude
	local t = math.clamp(dist / math.max(speed, 1), 1, 120)
	stopFarmTween()
	local tw = TweenService:Create(
		hrp,
		TweenInfo.new(t, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
		{CFrame = CFrame.new(target)}
	)
	Hub._farmTween = tw
	local done = false
	local c
	c = tw.Completed:Connect(function()
		done = true
		if c then c:Disconnect() end
	end)
	tw:Play()
	local t0 = tick()
	while not done and Hub.autoFarm and farmRunning do
		if not hrp.Parent then break end
		if tick() - t0 > t + 2 then break end
		task.wait(0.1)
	end
	pcall(function() if Hub._farmTween then Hub._farmTween:Cancel() end end)
	Hub._farmTween = nil
end

local function startAutoFarm()
	if farmRunning then return end
	farmRunning = true
	ensurePlatform()
	task.spawn(function()
		while Hub.autoFarm and farmRunning do
			pcall(farmOnce)
			if not Hub.autoFarm or not farmRunning then break end
			task.wait(0.25)
		end
		farmRunning = false
		stopFarmTween()
		destroyPlatform()
	end)
end

local function stopAutoFarm()
	Hub.autoFarm = false
	farmRunning = false
	stopFarmTween()
	destroyPlatform()
end

localPlayer.CharacterRemoving:Connect(function()
	stopFarmTween()
	destroyPlatform()
end)

local function findMainFrame()
	local gui = pg:FindFirstChild("ElevatorTP")
	if not gui then return nil end
	return gui:FindFirstChild("Frame")
end

local function findTabBar(frame)
	for _, c in pairs(frame:GetChildren()) do
		if c:IsA("Frame") and c.Size.Y.Offset == 28 and c.Position.Y.Offset == 26 then
			return c
		end
	end
	return nil
end

local function findContent(frame)
	for _, c in pairs(frame:GetChildren()) do
		if c:IsA("Frame") and c.Position.Y.Offset >= 50 then
			return c
		end
	end
	return nil
end

local function makeBtn(parent, text, y, color)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.9, 0, 0, 26)
	btn.Position = UDim2.new(0.05, 0, y, 0)
	btn.BackgroundColor3 = color
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.Gotham
	btn.TextSize = 12
	btn.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 5)
	c.Parent = btn
	return btn
end

task.spawn(function()
	for _ = 1, 60 do
		local frame = findMainFrame()
		if frame then
			local tabBar = findTabBar(frame)
			local content = findContent(frame)
			if tabBar and content and not content:FindFirstChild("Farm") then
				local order = 0
				for _, btn in pairs(tabBar:GetChildren()) do
					if btn:IsA("TextButton") then
						order = order + 1
						btn.Size = UDim2.new(0.25, -2, 1, 0)
						btn.Position = UDim2.new((order - 1) * 0.25, 1, 0, 0)
					end
				end

				local farmPage = Instance.new("Frame")
				farmPage.Name = "Farm"
				farmPage.Size = UDim2.new(1, 0, 1, 0)
				farmPage.BackgroundTransparency = 1
				farmPage.Visible = false
				farmPage.Parent = content

				local farmTab = Instance.new("TextButton")
				farmTab.Name = "FarmTab"
				farmTab.Size = UDim2.new(0.25, -2, 1, 0)
				farmTab.Position = UDim2.new(0.75, 1, 0, 0)
				farmTab.BackgroundColor3 = Color3.fromRGB(35, 35, 48)
				farmTab.Text = "Farm"
				farmTab.TextColor3 = Color3.fromRGB(255, 255, 255)
				farmTab.Font = Enum.Font.GothamBold
				farmTab.TextSize = 11
				farmTab.BorderSizePixel = 0
				farmTab.Parent = tabBar

				local function switchToFarm()
					for _, p in pairs(content:GetChildren()) do
						if p:IsA("Frame") then p.Visible = false end
					end
					farmPage.Visible = true
					for _, b in pairs(tabBar:GetChildren()) do
						if b:IsA("TextButton") then
							b.BackgroundColor3 = (b == farmTab) and Color3.fromRGB(60, 60, 90) or Color3.fromRGB(35, 35, 48)
						end
					end
				end
				farmTab.MouseButton1Click:Connect(switchToFarm)

				for _, b in pairs(tabBar:GetChildren()) do
					if b:IsA("TextButton") and b ~= farmTab then
						b.MouseButton1Click:Connect(function()
							farmPage.Visible = false
						end)
					end
				end

				local antiBtn = makeBtn(farmPage, "Anti AFK: OFF", 0.06, Color3.fromRGB(180, 50, 50))
				antiBtn.MouseButton1Click:Connect(function()
					pcall(function()
						setAntiAfk(not Hub.antiAfk)
						antiBtn.Text = Hub.antiAfk and "Anti AFK: ON" or "Anti AFK: OFF"
						antiBtn.BackgroundColor3 = Hub.antiAfk and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(180, 50, 50)
					end)
				end)

				local farmBtn = makeBtn(farmPage, "Auto Farm Wins: OFF", 0.22, Color3.fromRGB(180, 50, 50))
				farmBtn.MouseButton1Click:Connect(function()
					pcall(function()
						if Hub.autoFarm then
							stopAutoFarm()
							farmBtn.Text = "Auto Farm Wins: OFF"
							farmBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
						else
							Hub.autoFarm = true
							startAutoFarm()
							farmBtn.Text = "Auto Farm Wins: ON"
							farmBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
						end
					end)
				end)

				local speedLabel = Instance.new("TextLabel")
				speedLabel.Size = UDim2.new(0.9, 0, 0, 18)
				speedLabel.Position = UDim2.new(0.05, 0, 0.40, 0)
				speedLabel.BackgroundTransparency = 1
				speedLabel.Text = "Tween speed (25-50)"
				speedLabel.TextColor3 = Color3.fromRGB(180, 180, 200)
				speedLabel.Font = Enum.Font.Gotham
				speedLabel.TextSize = 11
				speedLabel.TextXAlignment = Enum.TextXAlignment.Left
				speedLabel.Parent = farmPage

				local speedBox = Instance.new("TextBox")
				speedBox.Size = UDim2.new(0.9, 0, 0, 26)
				speedBox.Position = UDim2.new(0.05, 0, 0.48, 0)
				speedBox.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
				speedBox.Text = tostring(Hub.farmSpeed)
				speedBox.PlaceholderText = "25-50"
				speedBox.TextColor3 = Color3.fromRGB(255, 255, 255)
				speedBox.Font = Enum.Font.Gotham
				speedBox.TextSize = 13
				speedBox.ClearTextOnFocus = false
				speedBox.Parent = farmPage
				local sc = Instance.new("UICorner")
				sc.CornerRadius = UDim.new(0, 5)
				sc.Parent = speedBox

				local function applySpeed()
					local v = clampSpeed(speedBox.Text)
					Hub.farmSpeed = v
					speedBox.Text = tostring(v)
				end
				speedBox.FocusLost:Connect(applySpeed)
				speedBox:GetPropertyChangedSignal("Text"):Connect(function()
					local n = tonumber(speedBox.Text)
					if n then
						if n > 50 then
							Hub.farmSpeed = 50
							speedBox.Text = "50"
						elseif n < 25 and #speedBox.Text >= 2 then
							Hub.farmSpeed = 25
							speedBox.Text = "25"
						else
							Hub.farmSpeed = clampSpeed(n)
						end
					end
				end)

				local info = Instance.new("TextLabel")
				info.Size = UDim2.new(0.9, 0, 0, 40)
				info.Position = UDim2.new(0.05, 0, 0.62, 0)
				info.BackgroundTransparency = 1
				info.Text = "X 1-100  Y 1820\nZ 100-400  + platform"
				info.TextColor3 = Color3.fromRGB(140, 145, 165)
				info.Font = Enum.Font.Gotham
				info.TextSize = 11
				info.TextXAlignment = Enum.TextXAlignment.Left
				info.Parent = farmPage

				break
			end
		end
		task.wait(0.1)
	end
end)
