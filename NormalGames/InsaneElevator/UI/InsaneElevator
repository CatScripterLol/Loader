local function checkVersion()
	local ok, remote = pcall(function()
		return game:HttpGet(VERSION_URL .. "?t=" .. tostring(tick()) .. "&r=" .. tostring(math.random(1, 999999999)))
	end)
	if not ok or type(remote) ~= "string" then return false end
	remote = remote:gsub("%s+", "")
	if remote ~= "" and remote ~= LOCAL_VERSION then
		pcall(function()
			player:Kick("ElevatorHub updated (v" .. tostring(remote) .. "). Re-execute the loadstring.")
		end)
		return true
	end
	return false
end

