local function makeTab(text, order, page)
	local b = Instance.new("TextButton")
	b.Size, b.Position = UDim2.new(0.25, -2, 1, 0), UDim2.new(order * 0.25, 1, 0, 0)
	b.BackgroundColor3, b.Text, b.TextColor3 = Color3.fromRGB(35, 35, 48), text, Color3.fromRGB(255, 255, 255)
	b.Font, b.TextSize, b.BorderSizePixel, b.Parent = Enum.Font.GothamBold, 11, 0, tabBar
	b.MouseButton1Click:Connect(function()
		for _, p in pairs(pages) do p.Visible = false end
		page.Visible = true
		for _, x in pairs(tabBar:GetChildren()) do
			if x:IsA("TextButton") then x.BackgroundColor3 = (x == b) and Color3.fromRGB(60, 60, 90) or Color3.fromRGB(35, 35, 48) end
		end
	end)
	return b
end
local function makeBtn(parent, text, y, color)
