local function perfInterval()
	local fps = 60
	pcall(function() fps = workspace:GetRealPhysicsFPS() end)
	if fps < 25 then return 1.0 end
	if fps < 40 then return 0.75 end
	return 0.5
end

function Hub.clearHighlights(tbl)
	if type(tbl) ~= "table" then return end
	for _, h in pairs(tbl) do
		pcall(function() if h and h.Parent then h:Destroy() end end)
	end
	table.clear(tbl)
end

function Hub.applyHighlight(obj, color, tbl)
	if not obj or not obj.Parent then return end
	local existing = obj:FindFirstChild("ESPHighlight")
	if existing then
		existing.FillColor = color
		existing.OutlineColor = color
		return
	end
	local h = Instance.new("Highlight")
	h.Name = "ESPHighlight"
	h.Adornee = obj
	h.FillColor = color
	h.OutlineColor = color
	h.FillTransparency = 0.5
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = obj
	table.insert(tbl, h)
end

function Hub.teleport(pos)
	pcall(function()
		local char = player.Character or player.CharacterAdded:Wait()
		local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
		if not hrp then return end
		if char.PrimaryPart then char:PivotTo(CFrame.new(pos)) else hrp.CFrame = CFrame.new(pos) end
	end)
end

function Hub.isKiller(model)
	if not model or not model:IsA("Model") then return false end
	if Players:GetPlayerFromCharacter(model) then return false end
	if Players:FindFirstChild(model.Name) then return false end
	local n = string.lower(model.Name)
	if string.find(n, "killer") or string.find(n, "enemy") or string.find(n, "npc") then return true end
	if model:FindFirstChildOfClass("Humanoid") then
		if string.find(n, "boss") or string.find(n, "monster") or string.find(n, "entity") or string.find(n, "ai") then return true end
	end
	return false
end

function Hub.setCleanVision(on)
	Hub.cleanVision = on and true or false
	pcall(function()
		if on then
			if not Hub._lightingBackup then
				Hub._lightingBackup = {
					FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart, FogColor = Lighting.FogColor,
					Brightness = Lighting.Brightness, Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
				}
			end
			Lighting.FogEnd, Lighting.FogStart = 9e9, 0
			Lighting.FogColor = Color3.fromRGB(255, 255, 255)
			Lighting.Brightness = 2.5
			Lighting.Ambient = Color3.fromRGB(180, 180, 180)
			Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
			for _, v in pairs(Lighting:GetChildren()) do
				if v:IsA("BlurEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect")
					or v:IsA("DepthOfFieldEffect") or v:IsA("SunRaysEffect") or v:IsA("Atmosphere") then
					pcall(function() v.Enabled = false end)
				end
			end
		else
			local b = Hub._lightingBackup
			if b then
				Lighting.FogEnd, Lighting.FogStart, Lighting.FogColor = b.FogEnd, b.FogStart, b.FogColor
				Lighting.Brightness, Lighting.Ambient, Lighting.OutdoorAmbient = b.Brightness, b.Ambient, b.OutdoorAmbient
			end
			for _, v in pairs(Lighting:GetChildren()) do
				if v:IsA("BlurEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect")
					or v:IsA("DepthOfFieldEffect") or v:IsA("SunRaysEffect") or v:IsA("Atmosphere") then
					pcall(function() v.Enabled = true end)
				end
			end
		end
	end)
end

function Hub.handleAntiRadio()
	pcall(function()
		for _, parent in pairs({workspace, SoundService}) do
			for _, v in pairs(parent:GetDescendants()) do
				if v:IsA("Sound") then
					local n = string.lower(v.Name)
					if string.find(n, "radio") or string.find(n, "music") or string.find(n, "broadcast") or string.find(n, "speaker") then
						v.Volume = 0
						pcall(function() v:Stop() end)
					end
				end
			end
		end
	end)
end

function Hub.setAntiRadio(on)
	Hub.antiRadio = on and true or false
	if on then Hub.handleAntiRadio() end
end

function Hub.scanFloor()
	local name = "Unknown"
	pcall(function()
		local cf = workspace:FindFirstChild("CurrentFloor")
		if cf then
			name = cf.Name
			if cf:IsA("StringValue") or cf:IsA("NumberValue") then name = tostring(cf.Value) end
			local sv = cf:FindFirstChildWhichIsA("StringValue")
			if sv then name = tostring(sv.Value) end
		end
		for _, v in pairs(workspace:GetChildren()) do
			local ln = string.lower(v.Name)
			if string.find(ln, "floor") and not string.find(ln, "elevator") then
				if v:IsA("Folder") or v:IsA("Model") then name = v.Name break end
			end
		end
	end)
	Hub.lastFloorName = name
	return name
end

function Hub.predictFloor()
	local current = Hub.scanFloor()
	local nextName = nil
	pcall(function()
		local candidates = {
			workspace:FindFirstChild("NextFloor"),
			workspace:FindFirstChild("UpcomingFloor"),
			workspace:FindFirstChild("PredictedFloor"),
			RS:FindFirstChild("NextFloor"),
			RS:FindFirstChild("UpcomingFloor"),
		}
		for _, o in pairs(candidates) do
			if o then
				if o:IsA("StringValue") or o:IsA("NumberValue") then nextName = tostring(o.Value) break end
				nextName = o.Name
				break
			end
		end
		if not nextName then
			for _, v in pairs(workspace:GetDescendants()) do
				local n = string.lower(v.Name)
				if (string.find(n, "nextfloor") or string.find(n, "upcoming")) and (v:IsA("StringValue") or v:IsA("NumberValue")) then
					nextName = tostring(v.Value)
					break
				end
			end
		end
		local queue = workspace:FindFirstChild("FloorQueue") or RS:FindFirstChild("FloorQueue")
		if queue then
			local kids = queue:GetChildren()
			if #kids >= 1 then
				local first = kids[1]
				nextName = (first:IsA("StringValue") and tostring(first.Value)) or first.Name
			end
		end
	end)
	if current and current ~= "Unknown" then
		local hist = Hub._floorHistory
		if #hist == 0 or hist[#hist] ~= current then
			table.insert(hist, current)
			if #hist > 8 then table.remove(hist, 1) end
		end
	end
	if not nextName then nextName = "waiting..." end
	Hub.predictedFloor = nextName
	return current, Hub.predictedFloor
end

function Hub.getGodUsers()
	local list = {}
	pcall(function()
		for _, plr in pairs(Players:GetPlayers()) do
			local found = false
			local function scan(parent)
				if not parent then return end
				for _, t in pairs(parent:GetChildren()) do
					local n = string.lower(t.Name)
					if string.find(n, "god") or string.find(n, "admin") or string.find(n, "immortal") or string.find(n, "mod") then found = true end
				end
			end
			scan(plr:FindFirstChild("Backpack"))
			scan(plr.Character)
			if found then table.insert(list, plr.Name) end
		end
	end)
	return list
end

