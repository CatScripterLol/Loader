	if Hub.autoFarm then stopAutoFarm() else Hub.autoFarm = true startAutoFarm() end
	toggleBtn(a2, Hub.autoFarm, "Auto Farm Wins: ON", "Auto Farm Wins: OFF")
end)
local speedBox = Instance.new("TextBox")
speedBox.Size, speedBox.Position = UDim2.new(0.9, 0, 0, 28), UDim2.new(0.05, 0, 0.40, 0)
speedBox.BackgroundColor3, speedBox.Text, speedBox.PlaceholderText = Color3.fromRGB(40, 40, 55), tostring(Hub.farmSpeed), "25-100"
speedBox.TextColor3, speedBox.Font, speedBox.TextSize, speedBox.Parent = Color3.fromRGB(255, 255, 255), Enum.Font.Gotham, 13, farm
Instance.new("UICorner", speedBox).CornerRadius = UDim.new(0, 6)
speedBox.FocusLost:Connect(function()
	Hub.farmSpeed = clampSpeed(speedBox.Text)
	speedBox.Text = tostring(Hub.farmSpeed)
end)
local info = Instance.new("TextLabel")
info.Size, info.Position, info.BackgroundTransparency = UDim2.new(0.9, 0, 0, 40), UDim2.new(0.05, 0, 0.58, 0), 1
info.Text, info.TextColor3, info.Font, info.TextSize = "Y 1820  platform follows\nX 1-100  Z 100-400", Color3.fromRGB(140, 145, 165), Enum.Font.Gotham, 11
info.TextXAlignment, info.Parent = Enum.TextXAlignment.Left, farm
