	Hub.autoFarm, farmRunning = false, false
	stopFarmTween()
	destroyPlatform()
end
local function clampSpeed(n)
	local mode = Hub.farmMode or "tween"
	local maxv = (mode == "tp") and 60 or 1000
	return math.clamp(math.floor((tonumber(n) or (mode == "tp" and 10 or 25)) + 0.5), 1, maxv)
end
local FARM_Y = 1820
local FARM_CX, FARM_CZ = 2, -3
local FARM_HALF = 2500
local FARM_MIN_DIST = 150
local function randomFarmPos(fromPos)
	local target
	for _ = 1, 50 do
		local x = FARM_CX + math.random(-FARM_HALF, FARM_HALF)
		local z = FARM_CZ + math.random(-FARM_HALF, FARM_HALF)
		target = Vector3.new(x, FARM_Y, z)
		if not fromPos or (fromPos - target).Magnitude >= FARM_MIN_DIST then return target end
	end
	return target or Vector3.new(FARM_CX, FARM_Y, FARM_CZ)
end
local function farmOnce()
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then task.wait(0.3) return end
	ensurePlatform()
	stopFarmTween()
	local target = randomFarmPos(hrp.Position)
	local amount = clampSpeed(Hub.farmSpeed)
	Hub.farmSpeed = amount
	local mode = Hub.farmMode or "tween"
	if mode == "tp" then
		pcall(function()
			local char = player.Character
			if char and char.PrimaryPart then char:PivotTo(CFrame.new(target)) else hrp.CFrame = CFrame.new(target) end
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end)
		task.wait(math.clamp(1 / math.max(amount, 1), 1 / 60, 2))
	else
		local dist = (hrp.Position - target).Magnitude
		local t = math.clamp(dist / math.max(amount, 1), 0.12, 90)
		local tw = TweenService:Create(hrp, TweenInfo.new(t, Enum.EasingStyle.Linear), {CFrame = CFrame.new(target)})
		Hub._farmTween = tw
		local done = false
		local c
		c = tw.Completed:Connect(function()
			done = true
			if c then c:Disconnect() end
		end)
		tw:Play()
		local t0 = tick()
		while not done and Hub.autoFarm and farmRunning do
			if not hrp.Parent or tick() - t0 > t + 2 then break end
			task.wait(0.1)
		end
		stopFarmTween()
	end
end
local function startAutoFarm()
	if farmRunning then return end
	farmRunning = true
	ensurePlatform()
	task.spawn(function()
		while Hub.autoFarm and farmRunning do
			pcall(farmOnce)
			if not Hub.autoFarm or not farmRunning then break end
			task.wait()
		end
		farmRunning = false
		stopFarmTween()
		destroyPlatform()
	end)
end
