function Hub.isKiller(model)
	if not model or not model:IsA("Model") then return false end
	if Players:GetPlayerFromCharacter(model) then return false end
	if Players:FindFirstChild(model.Name) then return false end
	local n = string.lower(model.Name)
	local exclude = {
		"elevator","lobby","shop","spawn","camera","baseplate","dummy","rig",
		"mannequin","statue","display","preview","template","clone","hitbox",
	}
	for _, e in ipairs(exclude) do
		if string.find(n, e, 1, true) then return false end
	end
	local keys = {
		"killer","enemy","boss","monster","entity","scp","granny","piggy",
		"baldi","jeff","slender","siren","john doe","johndoe","among us","alien",
		"cartoon cat","pennywise","puppet","lexi","terminator","trex","t-rex",
		"1x1x1x1","endoskeleton","ben ","lake ","foxy","freddy","chica","bonnie",
		"springtrap","nightmare","horror","threat","ghost","demon","zombie",
		"wendigo","chucky","annabelle","mimic","backrooms","hunter","stalker",
		"ao oni","aooni","nextbot","sanic","speed demon","cartoon dog",
	}
	for _, k in ipairs(keys) do
		if string.find(n, k, 1, true) then return true end
	end
	local parent = model.Parent
	if parent then
		local pn = string.lower(parent.Name)
		if string.find(pn, "killer") or string.find(pn, "enemy") or string.find(pn, "mobs")
			or string.find(pn, "threat") or string.find(pn, "bosses") then
			if model:FindFirstChildOfClass("Humanoid") or model:FindFirstChildWhichIsA("BasePart") then
				return true
			end
		end
	end
	return false
end

local function isRadioName(n)
	return string.find(string.lower(tostring(n or "")), "radio") ~= nil
end

function Hub.removeRadiosFromEveryone()
	pcall(function()
		if not Hub._hiddenRadios then Hub._hiddenRadios = {} end
		if not Hub._mutedSounds then Hub._mutedSounds = {} end
		local function hideTool(t)
			if not t or not t.Parent then return end
			if Hub._hiddenRadios[t] then return end
			Hub._hiddenRadios[t] = t.Parent
			t.Parent = nil
		end
		local function muteSound(s)
			if not s or not s:IsA("Sound") then return end
			if not Hub._mutedSounds[s] then
				Hub._mutedSounds[s] = {Volume = s.Volume, Playing = s.Playing, TimePosition = s.TimePosition}
			end
			s.Volume = 0
			pcall(function() s:Stop() end)
		end
		for _, plr in pairs(Players:GetPlayers()) do
			local function wipe(parent)
				if not parent then return end
				for _, t in pairs(parent:GetChildren()) do
					if (t:IsA("Tool") or t:IsA("HopperBin")) and isRadioName(t.Name) then hideTool(t) end
				end
			end
			wipe(plr:FindFirstChild("Backpack"))
			wipe(plr.Character)
			wipe(plr:FindFirstChild("StarterGear"))
		end
		for _, v in pairs(workspace:GetDescendants()) do
			if v:IsA("Tool") and isRadioName(v.Name) then hideTool(v)
			elseif v:IsA("Sound") and isRadioName(v.Name) then muteSound(v) end
		end
		for _, v in pairs(SoundService:GetDescendants()) do
			if v:IsA("Sound") and isRadioName(v.Name) then muteSound(v) end
		end
	end)
end

function Hub.restoreRadios()
	pcall(function()
		for tool, parent in pairs(Hub._hiddenRadios or {}) do
			if tool then
				pcall(function()
					if parent and parent.Parent then tool.Parent = parent
					elseif player:FindFirstChild("Backpack") then tool.Parent = player.Backpack end
				end)
			end
		end
		table.clear(Hub._hiddenRadios or {})
		for snd, data in pairs(Hub._mutedSounds or {}) do
			if snd and snd.Parent then
				pcall(function()
					snd.Volume = data.Volume or 1
					if data.Playing then
						snd.TimePosition = data.TimePosition or 0
						snd:Play()
					end
				end)
			end
		end
		table.clear(Hub._mutedSounds or {})
	end)
end

function Hub.handleAntiRadio()
	if Hub.antiRadio then Hub.removeRadiosFromEveryone() end
end

function Hub.setAntiRadio(on)
	Hub.antiRadio = on and true or false
	if Hub._radioConn then pcall(function() Hub._radioConn:Disconnect() end) Hub._radioConn = nil end
	if Hub._radioPlayerConn then pcall(function() Hub._radioPlayerConn:Disconnect() end) Hub._radioPlayerConn = nil end
	if on then
		Hub.removeRadiosFromEveryone()
		Hub._radioConn = workspace.DescendantAdded:Connect(function(obj)
			if not Hub.antiRadio then return end
			task.defer(function()
				if not obj or not obj.Parent then return end
				if (obj:IsA("Tool") or obj:IsA("HopperBin")) and isRadioName(obj.Name) then
					if not Hub._hiddenRadios then Hub._hiddenRadios = {} end
					if not Hub._hiddenRadios[obj] then
						Hub._hiddenRadios[obj] = obj.Parent
						obj.Parent = nil
					end
				elseif obj:IsA("Sound") and isRadioName(obj.Name) then
					if not Hub._mutedSounds then Hub._mutedSounds = {} end
					if not Hub._mutedSounds[obj] then
						Hub._mutedSounds[obj] = {Volume = obj.Volume, Playing = obj.Playing, TimePosition = obj.TimePosition}
					end
					obj.Volume = 0
					pcall(function() obj:Stop() end)
				end
			end)
		end)
		local function hookContainer(cont)
			if not cont then return end
			cont.ChildAdded:Connect(function(c)
				if Hub.antiRadio and (c:IsA("Tool") or c:IsA("HopperBin")) and isRadioName(c.Name) then
					task.defer(function()
						if not Hub._hiddenRadios then Hub._hiddenRadios = {} end
						if c.Parent and not Hub._hiddenRadios[c] then
							Hub._hiddenRadios[c] = c.Parent
							c.Parent = nil
						end
					end)
				end
			end)
		end
		for _, plr in pairs(Players:GetPlayers()) do
			hookContainer(plr:FindFirstChild("Backpack"))
			if plr.Character then hookContainer(plr.Character) end
			plr.CharacterAdded:Connect(function(char)
				hookContainer(char)
				if Hub.antiRadio then Hub.removeRadiosFromEveryone() end
			end)
		end
		Hub._radioPlayerConn = Players.PlayerAdded:Connect(function(plr)
			task.defer(function()
				hookContainer(plr:WaitForChild("Backpack", 10))
				plr.CharacterAdded:Connect(function(char) hookContainer(char) end)
			end)
		end)
	else
		Hub.restoreRadios()
	end
end

local function isSlapName(n)
	local ln = string.lower(tostring(n or ""))
	return ln == "slap hand" or ln == "slaphand" or string.find(ln, "slap hand", 1, true) ~= nil
end

function Hub.removeSlapsFromEveryone()
	pcall(function()
		if not Hub._hiddenSlaps then Hub._hiddenSlaps = {} end
		local function hideTool(t)
			if not t or not t.Parent then return end
			if Hub._hiddenSlaps[t] then return end
			Hub._hiddenSlaps[t] = t.Parent
			t.Parent = nil
		end
		for _, plr in pairs(Players:GetPlayers()) do
			local function wipe(parent)
				if not parent then return end
				for _, t in pairs(parent:GetChildren()) do
					if (t:IsA("Tool") or t:IsA("HopperBin")) and isSlapName(t.Name) then hideTool(t) end
				end
			end
			wipe(plr:FindFirstChild("Backpack"))
			wipe(plr.Character)
			wipe(plr:FindFirstChild("StarterGear"))
		end
		for _, v in pairs(workspace:GetDescendants()) do
			if v:IsA("Tool") and isSlapName(v.Name) then hideTool(v) end
		end
	end)
end

function Hub.restoreSlaps()
	pcall(function()
		for tool, parent in pairs(Hub._hiddenSlaps or {}) do
			if tool then
				pcall(function()
					if parent and parent.Parent then tool.Parent = parent
					elseif player:FindFirstChild("Backpack") then tool.Parent = player.Backpack end
				end)
			end
		end
		table.clear(Hub._hiddenSlaps or {})
	end)
end

function Hub.handleAntiSlap()
	if not Hub.antiSlap then return end
	Hub.removeSlapsFromEveryone()
	pcall(function()
		local char = player.Character
		if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum then return end
		pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false) end)
		pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false) end)
		pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false) end)
		pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false) end)
		local st = hum:GetState()
		if st == Enum.HumanoidStateType.Seated then
			pcall(function()
				hum.Sit = false
				hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end)
		elseif st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.FallingDown then
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
		end
		if hum.Sit then hum.Sit = false end
	end)
end

function Hub.setAntiSlap(on)
	Hub.antiSlap = on and true or false
	if Hub._slapConn then pcall(function() Hub._slapConn:Disconnect() end) Hub._slapConn = nil end
	if Hub._slapPlayerHooks then
		for _, c in pairs(Hub._slapPlayerHooks) do pcall(function() c:Disconnect() end) end
	end
	Hub._slapPlayerHooks = {}
	if on then
		Hub.removeSlapsFromEveryone()
		local function hideIfSlap(obj)
			if not Hub.antiSlap or not obj then return end
			if (obj:IsA("Tool") or obj:IsA("HopperBin")) and isSlapName(obj.Name) then
				if not Hub._hiddenSlaps then Hub._hiddenSlaps = {} end
				if not Hub._hiddenSlaps[obj] then
					Hub._hiddenSlaps[obj] = obj.Parent
					obj.Parent = nil
				end
			end
		end
		Hub._slapConn = workspace.DescendantAdded:Connect(function(obj)
			if not Hub.antiSlap then return end
			task.defer(function() hideIfSlap(obj) end)
		end)
		local function hookPlayer(plr)
			local function hookCont(cont)
				if not cont then return end
				local c = cont.ChildAdded:Connect(function(ch)
					task.defer(function() hideIfSlap(ch) end)
				end)
				table.insert(Hub._slapPlayerHooks, c)
			end
			hookCont(plr:FindFirstChild("Backpack"))
			if plr.Character then hookCont(plr.Character) end
			local ca = plr.CharacterAdded:Connect(function(char)
				hookCont(char)
				if Hub.antiSlap then Hub.removeSlapsFromEveryone() end
			end)
			table.insert(Hub._slapPlayerHooks, ca)
		end
		for _, plr in pairs(Players:GetPlayers()) do hookPlayer(plr) end
		local pa = Players.PlayerAdded:Connect(function(plr)
			task.defer(function() hookPlayer(plr) end)
		end)
		table.insert(Hub._slapPlayerHooks, pa)
		pcall(function()
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
				hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
				hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
				hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
			end
		end)
		if not Hub._slapCharConn then
			Hub._slapCharConn = player.CharacterAdded:Connect(function(char)
				task.defer(function()
					local hum = char:WaitForChild("Humanoid", 5)
					if hum and Hub.antiSlap then
						hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
						hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
						hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
						hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
					end
				end)
			end)
		end
	else
		Hub.restoreSlaps()
		pcall(function()
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
				hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
				hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
				hum:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
			end
		end)
	end
end

local function enforceCleanVision()
	if not Hub.cleanVision then return end
	pcall(function()
		Lighting.FogEnd = 1e6
		Lighting.FogStart = 0
		Lighting.FogColor = Color3.fromRGB(255, 255, 255)
		Lighting.Brightness = math.max(Lighting.Brightness, 2)
		for _, v in pairs(Lighting:GetChildren()) do
			if v:IsA("BlurEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect")
				or v:IsA("DepthOfFieldEffect") or v:IsA("SunRaysEffect") then
				pcall(function() v.Enabled = false end)
			elseif v:IsA("Atmosphere") then
				pcall(function()
					if not Hub._atmBackup then
						Hub._atmBackup = {Density = v.Density, Haze = v.Haze, Glare = v.Glare, Offset = v.Offset}
					end
					v.Density = 0
					v.Haze = 0
					v.Glare = 0
					v.Offset = 0
				end)
			end
		end
		for _, v in pairs(workspace:GetDescendants()) do
			local ln = string.lower(v.Name)
			if (v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire")) and (string.find(ln, "fog") or string.find(ln, "smoke") or string.find(ln, "mist") or string.find(ln, "haze")) then
				pcall(function() v.Enabled = false end)
			elseif v:IsA("BasePart") and (string.find(ln, "fog") or ln == "mist") then
				pcall(function() v.Transparency = 1 end)
			end
		end
		if not Lighting:FindFirstChild("ElevatorDefaultSky") then
			for _, v in pairs(Lighting:GetChildren()) do
				if v:IsA("Sky") and v.Name ~= "ElevatorDefaultSky" then
					if not Hub._skyBackup then Hub._skyBackup = {} end
					table.insert(Hub._skyBackup, v:Clone())
					v:Destroy()
				end
			end
			local sky = Instance.new("Sky")
			sky.Name = "ElevatorDefaultSky"
			sky.SkyboxBk = "rbxasset://textures/sky/sky512_bk.tex"
			sky.SkyboxDn = "rbxasset://textures/sky/sky512_dn.tex"
			sky.SkyboxFt = "rbxasset://textures/sky/sky512_ft.tex"
			sky.SkyboxLf = "rbxasset://textures/sky/sky512_lf.tex"
			sky.SkyboxRt = "rbxasset://textures/sky/sky512_rt.tex"
			sky.SkyboxUp = "rbxasset://textures/sky/sky512_up.tex"
			sky.Parent = Lighting
		end
	end)
end

function Hub.setCleanVision(on)
	Hub.cleanVision = on and true or false
	if Hub._cleanConn then pcall(function() Hub._cleanConn:Disconnect() end) Hub._cleanConn = nil end
	pcall(function()
		if on then
			if not Hub._lightingBackup then
				Hub._lightingBackup = {
					FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart, FogColor = Lighting.FogColor,
					Brightness = Lighting.Brightness, Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
				}
			end
			if not Hub._skyBackup then
				Hub._skyBackup = {}
				for _, v in pairs(Lighting:GetChildren()) do
					if v:IsA("Sky") then table.insert(Hub._skyBackup, v:Clone()) v:Destroy() end
				end
			end
			enforceCleanVision()
			Hub._cleanConn = Lighting.ChildAdded:Connect(function(child)
				if not Hub.cleanVision then return end
				task.defer(function()
					if child:IsA("BlurEffect") or child:IsA("ColorCorrectionEffect") or child:IsA("BloomEffect")
						or child:IsA("DepthOfFieldEffect") or child:IsA("SunRaysEffect") then
						pcall(function() child.Enabled = false end)
					elseif child:IsA("Atmosphere") then
						pcall(function() child.Density = 0 child.Haze = 0 child.Glare = 0 child.Offset = 0 end)
					elseif child:IsA("Sky") and child.Name ~= "ElevatorDefaultSky" then
						if not Hub._skyBackup then Hub._skyBackup = {} end
						table.insert(Hub._skyBackup, child:Clone())
						child:Destroy()
						enforceCleanVision()
					end
				end)
			end)
		else
			local b = Hub._lightingBackup
			if b then
				Lighting.FogEnd, Lighting.FogStart, Lighting.FogColor = b.FogEnd, b.FogStart, b.FogColor
				Lighting.Brightness, Lighting.Ambient, Lighting.OutdoorAmbient = b.Brightness, b.Ambient, b.OutdoorAmbient
			end
			for _, v in pairs(Lighting:GetChildren()) do
				if v:IsA("BlurEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect")
					or v:IsA("DepthOfFieldEffect") or v:IsA("SunRaysEffect") then
					pcall(function() v.Enabled = true end)
				end
				if v:IsA("Atmosphere") and Hub._atmBackup then
					pcall(function()
						v.Density = Hub._atmBackup.Density
						v.Haze = Hub._atmBackup.Haze
						v.Glare = Hub._atmBackup.Glare
						v.Offset = Hub._atmBackup.Offset
					end)
				end
				if v:IsA("Sky") and v.Name == "ElevatorDefaultSky" then v:Destroy() end
			end
			if Hub._skyBackup then
				for _, s in pairs(Hub._skyBackup) do s.Parent = Lighting end
				Hub._skyBackup = nil
			end
			Hub._lightingBackup = nil
			Hub._atmBackup = nil
		end
	end)
end

function Hub.scanFloor()
	local result = nil
	pcall(function()
		local function goodName(n)
			if not n or n == "" then return false end
			local ln = string.lower(n)
			if #n < 2 or #n > 60 then return false end
			local bad = {"elevator","baseplate","camera","terrain","lobby","shop","spawn","map","parts","folder","workspace","currentfloor","floor","unknown","model","part","spawnlocation","spawns","vip","afk"}
			for _, b in pairs(bad) do if ln == b then return false end end
			if string.find(ln, "elevator") or string.find(ln, "spawn") then return false end
			if Players:FindFirstChild(n) then return false end
			return true
		end
		local tryVals = {"CurrentFloor","Floor","FloorName","CurrentFloorName","ActiveFloor","Stage","Level","RoundFloor"}
		for _, nm in pairs(tryVals) do
			local o = workspace:FindFirstChild(nm, true) or RS:FindFirstChild(nm, true)
			if o then
				local v = nil
				if o:IsA("StringValue") or o:IsA("NumberValue") or o:IsA("IntValue") then v = tostring(o.Value)
				elseif o:IsA("TextLabel") or o:IsA("TextButton") then v = tostring(o.Text)
				else
					local sv = o:FindFirstChildWhichIsA("StringValue") or o:FindFirstChildWhichIsA("NumberValue")
					if sv then v = tostring(sv.Value) end
					if not v then local tl = o:FindFirstChildWhichIsA("TextLabel", true) if tl then v = tostring(tl.Text) end end
					if not v then v = o.Name end
				end
				if v and goodName(v) and string.lower(v) ~= string.lower(nm) then result = v break end
			end
		end
		if not result then
			for _, v in pairs(workspace:GetChildren()) do
				if v:IsA("Model") or v:IsA("Folder") then
					local n = v.Name
					if goodName(n) then
						local ln = string.lower(n)
						if v:FindFirstChildOfClass("Humanoid") or v:FindFirstChild("Map") or v:FindFirstChild("Floor") or v:FindFirstChildWhichIsA("BasePart")
							or string.find(ln, "floor") or string.find(ln, "killer") or string.find(ln, "boss") or string.find(ln, "scp") or string.find(ln, "entity") then
							result = n
						end
					end
				end
			end
		end
		if not result then
			for _, v in pairs(pg:GetDescendants()) do
				if (v:IsA("TextLabel") or v:IsA("TextButton")) and type(v.Text) == "string" then
					local t = v.Text
					local match = string.match(t, "[Ff]loor%s*[#:]?%s*(%d+)")
					if match then result = "Floor " .. match break end
					local ln = string.lower(t)
					if string.find(ln, "floor") and #t > 3 and #t < 40 and goodName(t) then result = t break end
				end
			end
		end
	end)
	if result and result ~= "" then Hub.lastFloorName = result end
	return Hub.lastFloorName or "Unknown"
end

function Hub.predictFloor()
	local current = Hub.scanFloor()
	Hub.predictedFloor = current
	return current
end

function Hub.getGodUsers()
	local list = {}
	pcall(function()
		for _, plr in pairs(Players:GetPlayers()) do
			local found = false
			local function scan(parent)
				if not parent then return end
				for _, t in pairs(parent:GetChildren()) do
					local n = string.lower(t.Name)
					if string.find(n, "god") or string.find(n, "admin") or string.find(n, "immortal") or string.find(n, "mod") then found = true end
				end
			end
			scan(plr:FindFirstChild("Backpack"))
			scan(plr.Character)
			if found then table.insert(list, plr.Name) end
		end
	end)
	return list
end

