local function ensureNameTag(model, text, color)
	local head = model:FindFirstChild("Head") or model:FindFirstChildWhichIsA("BasePart")
	if not head then return end
	local old = model:FindFirstChild("ElevatorNameTag")
	if old then
		local lbl = old:FindFirstChildOfClass("TextLabel")
		if lbl and lbl.Text == text then return end
		old:Destroy()
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "ElevatorNameTag"
	bb.Size = UDim2.new(0, 140, 0, 28)
	bb.StudsOffset = Vector3.new(0, 2.5, 0)
	bb.AlwaysOnTop = true
	bb.Adornee = head
	bb.Parent = model
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, 0, 1, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = text
	lbl.TextColor3 = color
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 14
	lbl.TextStrokeTransparency = 0.4
	lbl.Parent = bb
end

local lastWho = 0
RunService.Heartbeat:Connect(function()
	local now = tick()
	if now - lastWho < 0.45 then return end
	lastWho = now

	local playerNames = {}
	local killerNames = {}

	for _, plr in pairs(Players:GetPlayers()) do
		table.insert(playerNames, plr.Name)
		local char = plr.Character
		if Hub.playerESP and char then
			Hub.applyHighlight(char, Color3.fromRGB(60, 180, 255), Hub.playerHighlights)
			ensureNameTag(char, "Player: " .. plr.Name, Color3.fromRGB(100, 200, 255))
		elseif char then
			local tag = char:FindFirstChild("ElevatorNameTag")
			if tag then tag:Destroy() end
		end
	end
	if not Hub.playerESP then
		Hub.clearHighlights(Hub.playerHighlights)
	end

	for _, v in pairs(workspace:GetDescendants()) do
		if v:IsA("Model") and Hub.isKiller and Hub.isKiller(v) then
			table.insert(killerNames, v.Name)
			if Hub.killerESP then
				ensureNameTag(v, "Killer: " .. v.Name, Color3.fromRGB(255, 80, 80))
			else
				local tag = v:FindFirstChild("ElevatorNameTag")
				if tag then tag:Destroy() end
			end
		end
	end

	local pText = #playerNames > 0 and table.concat(playerNames, ", ") or "-"
	local kText = #killerNames > 0 and table.concat(killerNames, ", ") or "-"
	whoList.Text = '<font color="#7ec8ff">Players:</font> ' .. pText
		.. '\n<font color="#ff7e7e">Killers:</font> ' .. kText
	local h = 40 + math.floor((#pText + #kText) / 24) * 14
	whoList.Size = UDim2.new(1, -4, 0, math.max(50, h))
	whoScroll.CanvasSize = UDim2.new(0, 0, 0, whoList.Size.Y.Offset)
end)
