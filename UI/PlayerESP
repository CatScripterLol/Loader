Hub.playerHighlights = Hub.playerHighlights or {}

local function findEspPage()
	local gui = pg:FindFirstChild("ElevatorTP")
	if not gui then return nil end
	local frame = gui:FindFirstChild("Frame")
	if not frame then return nil end
	local content = nil
	for _, c in pairs(frame:GetChildren()) do
		if c:IsA("Frame") and c.Position.Y.Offset >= 50 then
			content = c
			break
		end
	end
	if not content then return nil end
	return content:FindFirstChild("ESP")
end

local function makeBtn(parent, text, y, color)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.9, 0, 0, 26)
	btn.Position = UDim2.new(0.05, 0, y, 0)
	btn.BackgroundColor3 = color
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.Gotham
	btn.TextSize = 12
	btn.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 5)
	c.Parent = btn
	return btn
end

task.spawn(function()
	for _ = 1, 50 do
		local page = findEspPage()
		if page then
			local playerESPBtn = makeBtn(page, "ESP Players: OFF", 0.56, Color3.fromRGB(180, 50, 50))
			playerESPBtn.MouseButton1Click:Connect(function()
				Hub.playerESP = not Hub.playerESP
				if not Hub.playerESP then
					Hub.clearHighlights(Hub.playerHighlights)
					for _, p in pairs(Players:GetPlayers()) do
						if p.Character then
							local tag = p.Character:FindFirstChild("ElevatorNameTag")
							if tag then tag:Destroy() end
						end
					end
				end
				playerESPBtn.Text = Hub.playerESP and "ESP Players: ON" or "ESP Players: OFF"
				playerESPBtn.BackgroundColor3 = Hub.playerESP and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(180, 50, 50)
			end)
			break
		end
		task.wait(0.1)
	end
end)

