Hub.onFloorUpdate = function(name)
	predLabel.Text = "Floor: " .. tostring(name)
end

Hub.onGodUpdate = function(names)
	if #names == 0 then
		godList.Text = "None"
		godList.TextColor3 = Color3.fromRGB(150, 150, 150)
	else
		godList.Text = table.concat(names, "\n")
		godList.TextColor3 = Color3.fromRGB(255, 100, 100)
	end
	godList.Size = UDim2.new(1, -4, 0, math.max(20, #names * 16 + 8))
	godScroll.CanvasSize = UDim2.new(0, 0, 0, godList.Size.Y.Offset)
end
